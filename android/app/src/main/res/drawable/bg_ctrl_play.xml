<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_ctrl_play.xml
    Background for the 72dp play/pause center button.
    Red-accented dark circle matching the GlobalPlayer play control.
    Ripple gives touch feedback without obscuring the outline.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#55FF1F2D">

    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <solid android:color="#D90C0C0F" />
            <stroke
                android:width="2dp"
                android:color="#FFE50914" />
        </shape>
    </item>

</ripple>
